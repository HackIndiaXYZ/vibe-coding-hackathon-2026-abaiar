# =============================================================================
# OmniAI Edu - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit the .env file to version control!
# =============================================================================

# --- DashScope (Qwen/通义千问) ------------------------------------------------
DASHSCOPE_API_KEY="your-dashscope-api-key"
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODELS=qwen-plus,qwen-turbo,qwen-max
ALI_MODEL_NAME=qwen-plus

# --- OpenAI -------------------------------------------------------------------
# OPENAI_API_KEY="your-openai-api-key"
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-4o,gpt-4o-mini,gpt-4-turbo,gpt-3.5-turbo

# --- Anthropic ----------------------------------------------------------------
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODELS=claude-sonnet-4-20250514,claude-3-5-haiku-20241022

# --- DeepSeek -----------------------------------------------------------------
# DEEPSEEK_API_KEY="your-deepseek-api-key"
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner

# --- Google -------------------------------------------------------------------
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
# GOOGLE_MODELS=gemini-2.0-flash,gemini-1.5-pro

# --- GLM (智谱) ----------------------------------------------------------------
# GLM_API_KEY="your-glm-api-key"
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODELS=glm-4-plus,glm-4-flash,glm-4

# --- Default Model ------------------------------------------------------------
DEFAULT_MODEL=qwen-plus

# --- Login Service (Memory Mode) ----------------------------------------------
# DEFAULT_TEACHER_PASSWORD=changeme
# DEFAULT_ADMIN_PASSWORD=changeme
# DEFAULT_STUDENT_PASSWORD=changeme

# --- Misc ---------------------------------------------------------------------
USE_LIGHTRAG=True
